<Project>

  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <!--
    The shipped libraries take no package dependencies at all: System.Text.Json and its
    source generator are in the shared framework for every target here. Everything below
    is build-time or test-time only.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="MSTest" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

</Project>
