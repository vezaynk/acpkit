<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <!--
    Doc generation is on so the compiler resolves <see cref="..."/> targets: a renamed or
    deleted symbol then breaks the build instead of rotting in a comment. CS1591 (missing
    doc) is off for generated code, which is re-enabled per-project where it is wanted.
  -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1573</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <!--
      0.0.x while the shape of the public API is still settling. Both lines carry the same
      version: at 0.0.x nothing here claims stability, and the v2 line rests on a schema
      upstream still tags 2.0.0-alpha, so a separate prerelease suffix would say nothing the
      major version does not already say.
    -->
    <VersionPrefix>0.0.1</VersionPrefix>
    <AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
    <FileVersion>$(VersionPrefix)</FileVersion>
    <Authors>Slava Knyazev</Authors>
    <Company>Slava Knyazev</Company>
    <Copyright>Copyright (c) 2026 Slava Knyazev</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/vezaynk/acpkit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vezaynk/acpkit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>acp;agent-client-protocol;agent;llm;jsonrpc;aot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)NOTICE" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
