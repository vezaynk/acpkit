<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <!--
    Doc generation is on so the compiler resolves <see cref="..."/> targets: a renamed or
    deleted symbol then breaks the build instead of rotting in a comment. CS1591 (missing
    doc) is off for generated code, which is re-enabled per-project where it is wanted.
  -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1573</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <!--
      The version comes from the git tag, via MinVer. There is deliberately no version in this
      file: a number that lives in source has to be bumped in a pull request before every
      release, and is then wrong on every commit that follows until the next one. A tag is the
      thing that actually marks a release, so it is the thing that should carry the number.

      Untagged commits build as a prerelease off the last tag, which is what a CI build of
      unreleased work should be.
    -->
    <Authors>Slava Knyazev</Authors>
    <Company>Slava Knyazev</Company>
    <Copyright>Copyright (c) 2026 Slava Knyazev</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/vezaynk/acpkit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vezaynk/acpkit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>acp;agent-client-protocol;agent;llm;jsonrpc;aot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)NOTICE" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Tags are written v0.0.3, so the prefix has to be stripped to get a version. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

</Project>
