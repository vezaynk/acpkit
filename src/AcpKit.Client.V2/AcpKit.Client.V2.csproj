<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>AcpKit.Protocol.V2</RootNamespace>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>AcpKit.Client.V2</PackageId>
    <Title>Build an ACP client against the v2 protocol line.</Title>
    <Description>
      Implement IAcpClient and drive a typed connection to the agent, for the Agent Client
      Protocol v2 line. Generated from the official schema and free of reflection.
    </Description>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AcpKit.Protocol.V2/AcpKit.Protocol.V2.csproj" />
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
